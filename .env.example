# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (find in Neon dashboard → Connection Details)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Qwen / DashScope (paper summarization) ────────────────────────────────────
# Free token grant at: https://dashscope-intl.aliyuncs.com
# International (Singapore) endpoint — do not change unless migrating
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-long

# ── Gemini (Ask AI chat) ──────────────────────────────────────────────────────
# Free tier: 10 RPM / 1,000 RPD — sufficient for low-volume chat
# Get key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza-xxx
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash-lite-preview

# ── Ingestion Settings ────────────────────────────────────────────────────────
# Papers fetched per arXiv category per ingestion run
ARXIV_PAPERS_PER_CATEGORY=5
# Qwen rate limit (free tier is 10 RPM)
INGESTION_RATE_LIMIT_RPM=10

# ── Security ──────────────────────────────────────────────────────────────────
# Protects /api/internal/* endpoints from public access
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_SECRET=your-internal-secret-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for development
ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app
